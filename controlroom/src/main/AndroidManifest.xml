    </queries>

    <application android:label="Control Room">
        <activity android:name=".MainActivity" android:exported="true" android:resizeableActivity="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Read-only suite appearance for the other Wonderdesk apps. No personal data. -->
        <receiver android:name=".ArchiveResult" android:exported="false" />
        <!-- Crash reports from the other Wonderdesk apps (checked by caller package). -->
        <provider android:name=".CrashProvider" android:authorities="dev.wonderdesk.controlroom.crashes" android:exported="true" />
        <provider android:name=".AppearanceProvider" android:authorities="dev.wonderdesk.controlroom.appearance" android:exported="true" />
    </application>
</manifest>
